<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Admin Control Panel"
        android:textColor="#3B66FF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnNavVerify"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Review Doctor Verifications"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#F5F9FF"
        android:textColor="#1A1A1A"/>

    <Button
        android:id="@+id/btnNavUsers"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Manage Registered Users"
        android:backgroundTint="#F5F9FF"
        android:textColor="#1A1A1A"/>
</LinearLayout>