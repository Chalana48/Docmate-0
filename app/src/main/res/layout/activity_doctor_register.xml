<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Blue Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#7BAEE8"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_back_arrow"
                android:background="@drawable/circle_white_bg"
                android:padding="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doctor Registration"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginStart="12dp" />

        </LinearLayout>

        <!-- Form Body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Register as a doctor to access patient records (with patient consent). Please provide accurate information for verification."
                android:textSize="12sp"
                android:textColor="#555555"
                android:layout_marginBottom="20dp" />

            <!-- NIC Number -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NIC Number"
                android:textSize="14sp"
                android:textColor="#222222"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />
            <EditText
                android:id="@+id/etNic"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/input_field_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="text"
                android:layout_marginBottom="16dp" />

            <!-- Medical License -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Medical License / Registration Number"
                android:textSize="14sp"
                android:textColor="#222222"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />
            <EditText
                android:id="@+id/etLicenseNumber"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/input_field_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="text"
                android:layout_marginBottom="16dp" />

            <!-- Specialization Spinner -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Specialization"
                android:textSize="14sp"
                android:textColor="#222222"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />
            <Spinner
                android:id="@+id/spinnerSpecialization"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/input_field_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="16dp" />

            <!-- Hospital / Clinic -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hospital / Clinic"
                android:textSize="14sp"
                android:textColor="#222222"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />
            <EditText
                android:id="@+id/etHospital"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/input_field_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Select Hospital or Clinic"
                android:hintTextColor="#AAAAAA"
                android:inputType="text"
                android:layout_marginBottom="16dp" />

            <!-- Work Email -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Work Email"
                android:textSize="14sp"
                android:textColor="#222222"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />
            <EditText
                android:id="@+id/etWorkEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/input_field_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="doctor@hospital.com"
                android:hintTextColor="#AAAAAA"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="16dp" />

            <!-- Phone Number -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phone Number"
                android:textSize="14sp"
                android:textColor="#222222"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />
            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/input_field_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="+94 77 123 1230"
                android:hintTextColor="#AAAAAA"
                android:inputType="phone"
                android:layout_marginBottom="16dp" />

            <!-- Upload Verification Document -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upload Verification Document"
                android:textSize="14sp"
                android:textColor="#222222"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/layoutUpload"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/upload_box_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvUploadLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to upload (ID card / license proof)"
                    android:textSize="12sp"
                    android:textColor="#666666" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accepted: PDF, JPG, PNG (max 10MB)"
                    android:textSize="11sp"
                    android:textColor="#999999"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- Submit Button -->
            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Submit For Verification"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/btn_primary_bg"
                android:layout_marginBottom="12dp" />

            <!-- Already Verified Login -->
            <Button
                android:id="@+id/btnAlreadyVerified"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Already Verified? Login"
                android:textSize="16sp"
                android:textColor="#2255DD"
                android:textStyle="bold"
                android:background="@drawable/btn_outline_bg"
                android:layout_marginBottom="16dp" />

            <!-- Footer note -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Verification May Take Time. Your Documents Are Securely Stored And Reviewed Only By Authorized Admins."
                android:textSize="11sp"
                android:textColor="#888888"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
