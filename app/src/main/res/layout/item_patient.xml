<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/patient_card_bg"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <ImageView
        android:id="@+id/ivPatientAvatar"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:src="@drawable/ic_patient_avatar"
        android:background="@drawable/circle_avatar_bg"
        android:scaleType="centerCrop"
        android:layout_marginEnd="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPatientName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JOHN DOE"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tvPatientCondition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHRONIC HYPERTENSION"
            android:textSize="12sp"
            android:textColor="#666666"
            android:letterSpacing="0.04"
            android:layout_marginTop="3dp" />

    </LinearLayout>

</LinearLayout>
